{
  "expo": {
    "name": "AXP",
    "slug": "axp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.axp.player",
      "adaptiveIcon": {
        "foregroundImage": "./assets/artwork-placeholder.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "READ_MEDIA_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.axp.player",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "AXP no usa el micrófono.",
        "NSAppleMusicUsageDescription": "AXP necesita acceso a tu biblioteca de música.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-sqlite"
    ]
  }
}
